# LLM providers are attempted once each in this order for transient or invalid output.
LLM_PROVIDER=azure
LLM_FALLBACK_PROVIDERS=gemini,cloudflare,openrouter,openrouter_super

# Azure North Central Responses API primary.
AZURE_OPENAI_ENDPOINT=https://jack-m2x0qyej-northcentralus.openai.azure.com
AZURE_OPENAI_BASE_URL=https://jack-m2x0qyej-northcentralus.openai.azure.com/openai/v1
AZURE_OPENAI_MODEL=gpt-5.6-sol
# Set either AZURE_OPENAI_API_KEY or the path to a 0600 key file.
AZURE_OPENAI_API_KEY_FILE=

# Gemini fallback (Google's OpenAI-compatible endpoint).
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.5-flash
# Set either GEMINI_API_KEY or the path to a 0600 key file.
GEMINI_API_KEY_FILE=

# Cloudflare Workers AI first fallback (OpenAI-compatible endpoint).
CLOUDFLARE_ACCOUNT_ID=
# Optional override; defaults to the account-scoped URL built from the account ID.
CLOUDFLARE_AI_BASE_URL=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Set either CLOUDFLARE_API_TOKEN or the path to a 0600 token file.
CLOUDFLARE_API_TOKEN_FILE=

# OpenRouter fallback tiers. Both use the same OpenRouter credential.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Set either OPENROUTER_API_KEY or the path to a 0600 key file.
OPENROUTER_API_KEY_FILE=

# X/Twitter posting mode: api (default), browser, or disabled.
X_POST_METHOD=api

# Required when X_POST_METHOD=browser.
N8N_X_POST_WEBHOOK_URL=
N8N_X_POST_TOKEN=
N8N_X_POST_TIMEOUT_SECONDS=360
X_POST_DRY_RUN=false

# Keep these populated if you want to use or fall back to X_POST_METHOD=api.
TWITTER_API_KEY=
TWITTER_API_SECRET_KEY=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=
