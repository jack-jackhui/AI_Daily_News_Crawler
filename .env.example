# LLM provider. Azure remains the default when LLM_PROVIDER is unset.
# Optional fallbacks are attempted once each, in order, only for transient failures.
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDERS=openrouter,openrouter_super

# Gemini primary (Google's OpenAI-compatible endpoint).
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.5-flash
# Set either GEMINI_API_KEY or the path to a 0600 key file.
GEMINI_API_KEY_FILE=

# OpenRouter fallback tiers. Both use the same OpenRouter credential.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Set either OPENROUTER_API_KEY or the path to a 0600 key file.
OPENROUTER_API_KEY_FILE=

# X/Twitter posting mode: api (default), browser, or disabled.
X_POST_METHOD=api

# Required when X_POST_METHOD=browser.
N8N_X_POST_WEBHOOK_URL=
N8N_X_POST_TOKEN=
N8N_X_POST_TIMEOUT_SECONDS=360
X_POST_DRY_RUN=false

# Keep these populated if you want to use or fall back to X_POST_METHOD=api.
TWITTER_API_KEY=
TWITTER_API_SECRET_KEY=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=
